#version 430 core
// Reduce each 2x2 tile using MAX depth. A single clear/far pixel keeps a tile visible.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D u_source_hiz;
layout(r32f, binding = 0) writeonly uniform image2D u_destination;
uniform int u_source_level;

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 destination_size = imageSize(u_destination);
    if (any(greaterThanEqual(pixel, destination_size))) return;

    const ivec2 source_size = textureSize(u_source_hiz, u_source_level);
    const ivec2 base = pixel * 2;
    float maximum_depth = 0.0;
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            const ivec2 source_pixel = min(base + ivec2(x, y), source_size - 1);
            maximum_depth = max(maximum_depth,
                texelFetch(u_source_hiz, source_pixel, u_source_level).r);
        }
    }
    imageStore(u_destination, pixel, vec4(maximum_depth));
}
