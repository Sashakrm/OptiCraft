#version 430 core
// GPU-версия жадного мешера непрозрачной геометрии (см. Renderer::submit_gpu_batch и build_chunk_mesh в Chunk.cpp).
// Одна инвокация разбирает ОДИН срез одной секции в одном направлении грани: по 72 среза на секцию
// (32 по X, 8 по Y, 32 по Z) и два знака, то есть 576 работ на чанк. Срезы независимы: слияние
// идёт только внутри среза, как и в CPU-проходе, поэтому квады совпадают с CPU по составу.
//
// Вход — упакованные каналы чанка (палитры + биты, см. pack_channel в Chunk.cpp). Выход — 16-байтные
// записи квадов в общий пул (раскладка записи — в декодере terrain_gpu_vertex.glsl). Место под квады
// секции задаёт таблица ranges: (первый квад в пуле, ёмкость). Квады сверх ёмкости не пишутся, но
// считаются: по счётчику CPU видит переполнение и переносит чанк в больший участок пула.
//
// Ключ среза: UV-прямоугольник/поворот, AO и свет четырёх углов. Соседние блоки разных типов с одной
// текстурой сливаются, только если совпадают AO и свет всех углов (как в CPU-мешере).
layout(local_size_x = 64) in;

// Заголовок чанка: kGpuHeaderStride = 27 uvec4 (см. Chunk.h). [1].z = LOD stride (1/2/4).
// Каналы 23/24 содержат coarse-блоки и соответствующие метаданные; channel 0 остаётся полной копией.
layout(std430, binding = 0) readonly buffer Headers { uvec4 headers[]; };
layout(std430, binding = 1) readonly buffer Payload { uint payload[]; };
layout(std430, binding = 2) writeonly buffer Quads { uvec4 quads[]; };
// Счётчики потоков квадов: [ручка * 16 + вид * 4 + секция]. Здесь вид solid = 0.
layout(std430, binding = 3) buffer Counts { uint counts[]; };
// (id * 6 + грань) * 256 + метаданные -> индекс прямоугольника UV | поворот << 15.
layout(std430, binding = 4) readonly buffer Lut { uint rect_lut[]; };
// Таблицы правил: сначала light_coarse (256 слов), за ними block_flags — по id, длина по числу блоков.
layout(std430, binding = 5) readonly buffer Tables { uint light_coarse[256]; uint block_flags[]; };
// Место потока квадов в пуле: .x — индекс первого квада, .y — ёмкость в квадах. Индекс как у counts.
layout(std430, binding = 6) readonly buffer Ranges { uvec2 ranges[]; };

uniform int u_chunk_count;

const uint FLAG_GREEDY = 1u;
const uint FLAG_TRANSPARENT = 2u;
const uint FLAG_USES_META = 4u;
const uint FLAG_CULL_SAME = 8u;
const uint FLAG_OCCLUDES = 16u;
const uint ITEMS_PER_CHUNK = 576u;
// Шаг заголовка на чанк: два служебных uvec4 + 25 каналов.
const uint HEADER_STRIDE = 27u;
const uint KIND_SOLID = 1u;

// Значение i канала ch чанка hb. Битность 0 — одно значение палитры; иначе номер бит [i*b, i*b+b),
// возможно через границу двух слов.
uint read_channel(uint hb, uint ch, uint i) {
    const uvec4 c = headers[hb + 2u + ch];
    const uint bits = c.z;
    if (bits == 0u) return payload[c.x];
    const uint bit = i * bits;
    const uint w = c.y + (bit >> 5u);
    const uint s = bit & 31u;
    uint v = payload[w] >> s;
    if (s + bits > 32u) v |= payload[w + 1u] << (32u - s);
    return payload[c.x + (v & ((1u << bits) - 1u))];
}

// Индекс клетки кольца рёбер и углов (две или три координаты вне 0..31). Совпадает с chunk_ring_index
// в Chunk.h: рёбра вдоль Y — 0..127, вдоль X — 128..255, вдоль Z — 256..383, углы — 384..391.
int ring_index(int x, int y, int z) {
    const bool ox = x < 0 || x >= 32;
    const bool oy = y < 0 || y >= 32;
    const bool oz = z < 0 || z >= 32;
    const int px = x >= 32 ? 1 : 0;
    const int py = y >= 32 ? 1 : 0;
    const int pz = z >= 32 ? 1 : 0;
    if (int(ox) + int(oy) + int(oz) == 3) return 384 + px + 2 * py + 4 * pz;
    if (!oy) return (px + 2 * pz) * 32 + y;
    if (!ox) return 128 + (py + 2 * pz) * 32 + x;
    return 256 + (px + 2 * py) * 32 + z;
}

// Блок в клетке (x,y,z) чанка, за одной его границей (грани соседей) или в кольце рёбер и углов.
// Грани соседей: ячейка (a,b) лежит в индексе b*32+a; -X/+X: a=z,b=y; -Y/+Y: a=x,b=z; -Z/+Z: a=x,b=y.
uint block_at(uint hb, int x, int y, int z) {
    const int out_axes = int(x < 0 || x >= 32) + int(y < 0 || y >= 32) + int(z < 0 || z >= 32);
    if (out_axes >= 2) return read_channel(hb, 15u, uint(ring_index(x, y, z)));
    if (x < 0) return read_channel(hb, 3u, uint(y * 32 + z));
    if (x >= 32) return read_channel(hb, 4u, uint(y * 32 + z));
    if (y < 0) return read_channel(hb, 5u, uint(z * 32 + x));
    if (y >= 32) return read_channel(hb, 6u, uint(z * 32 + x));
    if (z < 0) return read_channel(hb, 7u, uint(y * 32 + x));
    if (z >= 32) return read_channel(hb, 8u, uint(y * 32 + x));
    return read_channel(hb, 0u, uint((y * 32 + z) * 32 + x));
}

// Для внутренней части дальнего чанка читаем coarse-копию (канал 23); за границей
// всегда используем точную грань/кольцо соседа, чтобы стыки чанков не зависели от LOD.
uint mesh_block_at(uint hb, int x, int y, int z, int lod_stride) {
    if (lod_stride <= 1 || x < 0 || x >= 32 || y < 0 || y >= 32 || z < 0 || z >= 32)
        return block_at(hb, x, y, z);
    return read_channel(hb, 23u, uint((y * 32 + z) * 32 + x));
}

int lod_sample_count(int stride) {
    return stride + (32 - 2 * stride) / stride + stride;
}

int lod_sample_coord(int index, int stride) {
    const int inner_count = (32 - 2 * stride) / stride;
    if (index < stride) return index;
    if (index < stride + inner_count) return stride + (index - stride) * stride;
    return 32 - stride + index - stride - inner_count;
}

int lod_sample_extent(int index, int stride, int sample_count) {
    return (index < stride || index >= sample_count - stride) ? 1 : stride;
}

uint light_at(uint hb, int x, int y, int z) {
    if (x < 0) return read_channel(hb, 9u, uint(y * 32 + z));
    if (x >= 32) return read_channel(hb, 10u, uint(y * 32 + z));
    if (y < 0) return read_channel(hb, 11u, uint(z * 32 + x));
    if (y >= 32) return read_channel(hb, 12u, uint(z * 32 + x));
    if (z < 0) return read_channel(hb, 13u, uint(y * 32 + x));
    if (z >= 32) return read_channel(hb, 14u, uint(y * 32 + x));
    return read_channel(hb, 2u, uint((y * 32 + z) * 32 + x));
}

// Закрывает ли клетка свет AO: полный непрозрачный куб (см. Mesh_Tables::occludes в Chunk.cpp).
bool occludes(uint hb, int x, int y, int z) {
    return (block_flags[block_at(hb, x, y, z)] & FLAG_OCCLUDES) != 0u;
}

// Вершинный AO четырёх углов грани клетки cell (ось axis, знак sign), как face_ao в Chunk.cpp: угол
// fu + 2*fv получает уровень 0..3 по двум боковым клеткам слоя перед гранью и по диагональной клетке.
uint face_ao(uint hb, ivec3 cell, int axis, int sign, int normal_extent, int ua, int va) {
    ivec3 base = cell;
    base[axis] += sign * normal_extent;
    uint code = 0u;
    for (int fv = 0; fv < 2; ++fv) {
        for (int fu = 0; fu < 2; ++fu) {
            const int du = fu != 0 ? 1 : -1;
            const int dv = fv != 0 ? 1 : -1;
            ivec3 p1 = base;
            ivec3 p2 = base;
            ivec3 p3 = base;
            p1[ua] += du;
            p2[va] += dv;
            p3[ua] += du;
            p3[va] += dv;
            const bool s1 = occludes(hb, p1.x, p1.y, p1.z);
            const bool s2 = occludes(hb, p2.x, p2.y, p2.z);
            const bool s3 = occludes(hb, p3.x, p3.y, p3.z);
            const uint level = (s1 && s2) ? 0u : 3u - (uint(s1) + uint(s2) + uint(s3));
            code |= level << uint(2 * (fu + 2 * fv));
        }
    }
    return code;
}

// Ключ грани: .x = индекс UV-прямоугольника | поворот<<15; .y = AO<<8 | присутствие<<16;
// .z = свет четырёх углов (байт угла: sky<<4 | blk). Для слияния сравнивается ВЕСЬ ключ.
uvec3 mask[1024];

// Свет четырёх углов грани (как face_corner_light в Chunk.cpp): среднее по клетке перед гранью и по
// трём клеткам слоя, непрозрачные клетки не учитываются, клетки за двумя границами чанка тоже.
uint face_corner_light(uint hb, ivec3 cell, int axis, int sign, int normal_extent, int ua, int va) {
    ivec3 base = cell;
    base[axis] += sign * normal_extent;
    uint code = 0u;
    for (int fv = 0; fv < 2; ++fv) {
        for (int fu = 0; fu < 2; ++fu) {
            const int du = fu != 0 ? 1 : -1;
            const int dv = fv != 0 ? 1 : -1;
            ivec3 pts[4];
            pts[0] = base;
            pts[1] = base;
            pts[2] = base;
            pts[3] = base;
            pts[1][ua] += du;
            pts[2][va] += dv;
            pts[3][ua] += du;
            pts[3][va] += dv;
            uint sky_sum = 0u;
            uint blk_sum = 0u;
            uint n = 0u;
            for (int i = 0; i < 4; ++i) {
                const ivec3 p = pts[i];
                const int out_axes = int(p.x < 0 || p.x >= 32) + int(p.y < 0 || p.y >= 32) +
                                     int(p.z < 0 || p.z >= 32);
                if (out_axes >= 2) continue;
                if (i > 0 && occludes(hb, p.x, p.y, p.z)) continue;
                const uint pk = light_at(hb, p.x, p.y, p.z);
                sky_sum += pk >> 4u;
                blk_sum += pk & 15u;
                ++n;
            }
            const uint sky = (sky_sum + n / 2u) / n;
            const uint blk = (blk_sum + n / 2u) / n;
            code |= ((sky << 4u) | blk) << uint(8 * (fu + 2 * fv));
        }
    }
    return code;
}

void main() {
    const uint g = gl_GlobalInvocationID.x;
    const uint chunk = g / ITEMS_PER_CHUNK;
    if (chunk >= uint(u_chunk_count)) return;
    const uint item = g - chunk * ITEMS_PER_CHUNK;
    const uint hb = chunk * HEADER_STRIDE;
    const uint handle = headers[hb].x;
    const uvec4 info = headers[hb + 1u];
    if ((info.y & KIND_SOLID) == 0u) return;

    const uint sec = item / 144u;
    const uint rem = item - sec * 144u;
    const bool pos = rem < 72u;
    // Изометрический снимок: отрицательные грани не видны с камеры и не строятся (как only_positive_faces).
    if (!pos && (info.x & 1u) != 0u) return;
    const int dir = pos ? 1 : -1;
    const int lod_stride = int(clamp(info.z, 1u, 4u));
    const uint r = pos ? rem : rem - 72u;
    int axis;
    int s;
    if (r < 32u) {
        axis = 0;
        s = int(r);
    } else if (r < 40u) {
        axis = 1;
        s = int(sec) * 8 + int(r - 32u);
    } else {
        axis = 2;
        s = int(r - 40u);
    }

    // В каждой оси оставляем точную полосу у границы чанка. Это сохраняет стыки
    // между соседями даже тогда, когда один чанк рисуется в LOD0, а другой в LOD2.
    int normal_extent = 1;
    if (lod_stride > 1 && s >= lod_stride && s < 32 - lod_stride) {
        if ((s - lod_stride) % lod_stride != 0) return;
        normal_extent = lod_stride;
    }
    // Первая coarse-группа примыкает отрицательной стороной к точной граничной
    // полосе; её ближайший сосед находится на расстоянии 1, а не lod_stride.
    const int neighbor_extent = (!pos && s == lod_stride && normal_extent > 1)
        ? 1 : normal_extent;

    // Оси среза: X -> u=Z, v=Y; Y -> u=X, v=Z; Z -> u=X, v=Y.
    const int ua = (axis == 0) ? 2 : 0;
    const int va = (axis == 1) ? 2 : 1;
    const int v_base = (va == 1) ? int(sec) * 8 : 0;
    const int v_count = (va == 1) ? 8 : 32;
    const uint face = uint(axis) * 2u + (pos ? 0u : 1u);
    // На внешних плоскостях чанка сохраняем полное разрешение и по касательным
    // осям: иначе крупный LOD-квад мог бы не совпасть с мелкими гранями соседа.
    const int sample_stride = (lod_stride > 1 && s >= lod_stride && s < 32 - lod_stride)
        ? lod_stride : 1;
    const int samples = lod_sample_count(sample_stride);

    // Маска индексируется координатами coarse-сетки, но каждая ячейка хранит
    // свою физическую ширину/высоту (1 или lod_stride блоков).
    for (int vi = 0; vi < samples; ++vi) {
        for (int ui = 0; ui < samples; ++ui) {
            mask[vi * 32 + ui] = uvec3(0u);
        }
    }

    bool any_key = false;
    for (int vi = 0; vi < samples; ++vi) {
        const int v = lod_sample_coord(vi, sample_stride);
        if (v < v_base || v >= v_base + v_count) continue;
        for (int ui = 0; ui < samples; ++ui) {
            const int u = lod_sample_coord(ui, sample_stride);
            ivec3 c;
            c[axis] = s;
            c[ua] = u;
            c[va] = v;
            uvec3 key = uvec3(0u);
            const uint cur = mesh_block_at(hb, c.x, c.y, c.z, lod_stride);
            const uint fc = block_flags[cur];
            if ((fc & FLAG_GREEDY) != 0u) {
                ivec3 nc = c;
                nc[axis] += dir * neighbor_extent;
                const uint nb = mesh_block_at(hb, nc.x, nc.y, nc.z, lod_stride);
                const bool cull_same = (fc & FLAG_CULL_SAME) != 0u;
                if ((block_flags[nb] & FLAG_TRANSPARENT) != 0u && !(nb == cur && cull_same)) {
                    uint meta = 0u;
                    if ((fc & FLAG_USES_META) != 0u) {
                        const uint meta_channel = (lod_stride > 1) ? 24u : 1u;
                        meta = read_channel(hb, meta_channel, uint((c.y * 32 + c.z) * 32 + c.x));
                    }
                    const uint material = rect_lut[(cur * 6u + face) * 256u + meta] & 0xFFFFu;
                    const uint ao = face_ao(hb, c, axis, dir, neighbor_extent, ua, va);
                    key = uvec3(material, (ao << 8u) | (1u << 16u),
                                face_corner_light(hb, c, axis, dir, neighbor_extent, ua, va));
                    any_key = true;
                }
            }
            mask[vi * 32 + ui] = key;
        }
    }
    if (!any_key) return;

    // Жадное слияние по coarse-ячейкам. Размер итогового квада записывается в физических
    // блоках, поэтому вершинный шейдеру не нужно выполнять дополнительный поиск соседей.
    for (int vi = 0; vi < samples; ++vi) {
        const int v = lod_sample_coord(vi, sample_stride);
        if (v < v_base || v >= v_base + v_count) continue;
        int ui = 0;
        while (ui < samples) {
            const uvec3 key = mask[vi * 32 + ui];
            if (key == uvec3(0u)) {
                ++ui;
                continue;
            }

            const uint lut = key.x;
            const bool rotate = (lut & 0x8000u) != 0u;
            int width_samples = 1;
            int height_samples = 1;
            if (!rotate) {
                while (ui + width_samples < samples &&
                       mask[vi * 32 + ui + width_samples] == key) {
                    ++width_samples;
                }
                bool grow = true;
                while (vi + height_samples < samples && grow) {
                    const int next_v = lod_sample_coord(vi + height_samples, sample_stride);
                    if (next_v < v_base || next_v >= v_base + v_count) break;
                    for (int i = 0; i < width_samples; ++i) {
                        if (mask[(vi + height_samples) * 32 + ui + i] != key) {
                            grow = false;
                            break;
                        }
                    }
                    if (grow) ++height_samples;
                }
            }

            int physical_width = 0;
            int physical_height = 0;
            for (int i = 0; i < width_samples; ++i)
                physical_width += lod_sample_extent(ui + i, sample_stride, samples);
            for (int i = 0; i < height_samples; ++i)
                physical_height += lod_sample_extent(vi + i, sample_stride, samples);

            for (int dv = 0; dv < height_samples; ++dv) {
                for (int du = 0; du < width_samples; ++du) {
                    mask[(vi + dv) * 32 + ui + du] = uvec3(0u);
                }
            }

            ivec3 o;
            o[axis] = s;
            o[ua] = lod_sample_coord(ui, sample_stride);
            o[va] = v;
            const uint rect = lut & 0x7FFFu;
            const uint ao = (key.y >> 8u) & 0xFFu;
            const uint normal_scale_log2 = normal_extent == 4 ? 2u : (normal_extent == 2 ? 1u : 0u);
            const uint w0 = uint(o.x) | (uint(o.y) << 5u) | (uint(o.z) << 10u) |
                            (uint(axis) << 15u) | ((pos ? 1u : 0u) << 17u) |
                            (uint(physical_width - 1) << 18u) | (uint(physical_height - 1) << 23u) |
                            (rotate ? (1u << 28u) : 0u) | (normal_scale_log2 << 29u);
            const uint w1 = rect | (ao << 24u);

            const uint stream = handle * 16u + sec;
            const uint idx = atomicAdd(counts[stream], 1u);
            const uvec2 range = ranges[stream];
            if (idx < range.y) {
                quads[range.x + idx] = uvec4(w0, w1, key.z, 0u);
            }
            ui += width_samples;
        }
    }
}
