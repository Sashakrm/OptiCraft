#version 430 core
// GPU-версия жадного мешера непрозрачной геометрии (см. Renderer::submit_gpu_batch и build_chunk_mesh в Chunk.cpp).
// Одна инвокация разбирает ОДИН срез одной секции в одном направлении грани: по 72 среза на секцию
// (32 по X, 8 по Y, 32 по Z) и два знака, то есть 576 работ на чанк. Срезы независимы: слияние
// идёт только внутри среза, как и в CPU-проходе, поэтому квады совпадают с CPU по составу.
//
// Вход — упакованные каналы чанка (палитры + биты, см. pack_channel в Chunk.cpp). Выход — 8-байтные
// записи квадов в пул (раскладка записи — в декодере terrain_gpu_vertex.glsl), по CAP записей на секцию.
layout(local_size_x = 64) in;

// Заголовок чанка: 16 uvec4. [0].x = слот пула; [1 + ch] = (палитра, слова, биты, 0) канала ch.
layout(std430, binding = 0) readonly buffer Headers { uvec4 headers[]; };
layout(std430, binding = 1) readonly buffer Payload { uint payload[]; };
layout(std430, binding = 2) writeonly buffer Quads { uvec2 quads[]; };
layout(std430, binding = 3) buffer Counts { uint counts[]; };
// (id * 6 + грань) * 256 + метаданные -> индекс прямоугольника UV | поворот << 15.
layout(std430, binding = 4) readonly buffer Lut { uint rect_lut[]; };
layout(std430, binding = 5) readonly buffer Tables { uint block_flags[256]; uint light_coarse[256]; };

uniform int u_chunk_count;
uniform int u_quad_cap;

const uint FLAG_GREEDY = 1u;
const uint FLAG_TRANSPARENT = 2u;
const uint FLAG_USES_META = 4u;
const uint FLAG_CULL_SAME = 8u;
const uint KEY_PRESENT = 1u << 24;
const uint KEY_ROTATE = 1u << 25;
const uint ITEMS_PER_CHUNK = 576u;

// Значение i канала ch чанка hb. Битность 0 — одно значение палитры; иначе номер бит [i*b, i*b+b),
// возможно через границу двух слов.
uint read_channel(uint hb, uint ch, uint i) {
    const uvec4 c = headers[hb + 1u + ch];
    const uint bits = c.z;
    if (bits == 0u) return payload[c.x];
    const uint bit = i * bits;
    const uint w = c.y + (bit >> 5u);
    const uint s = bit & 31u;
    uint v = payload[w] >> s;
    if (s + bits > 32u) v |= payload[w + 1u] << (32u - s);
    return payload[c.x + (v & ((1u << bits) - 1u))];
}

// Блок в клетке (x,y,z) чанка или за его границей (ровно одна координата вне 0..31).
// Грани соседей: ячейка (a,b) лежит в индексе b*32+a; -X/+X: a=z,b=y; -Y/+Y: a=x,b=z; -Z/+Z: a=x,b=y.
uint block_at(uint hb, int x, int y, int z) {
    if (x < 0) return read_channel(hb, 3u, uint(y * 32 + z));
    if (x >= 32) return read_channel(hb, 4u, uint(y * 32 + z));
    if (y < 0) return read_channel(hb, 5u, uint(z * 32 + x));
    if (y >= 32) return read_channel(hb, 6u, uint(z * 32 + x));
    if (z < 0) return read_channel(hb, 7u, uint(y * 32 + x));
    if (z >= 32) return read_channel(hb, 8u, uint(y * 32 + x));
    return read_channel(hb, 0u, uint((y * 32 + z) * 32 + x));
}

uint light_at(uint hb, int x, int y, int z) {
    if (x < 0) return read_channel(hb, 9u, uint(y * 32 + z));
    if (x >= 32) return read_channel(hb, 10u, uint(y * 32 + z));
    if (y < 0) return read_channel(hb, 11u, uint(z * 32 + x));
    if (y >= 32) return read_channel(hb, 12u, uint(z * 32 + x));
    if (z < 0) return read_channel(hb, 13u, uint(y * 32 + x));
    if (z >= 32) return read_channel(hb, 14u, uint(y * 32 + x));
    return read_channel(hb, 2u, uint((y * 32 + z) * 32 + x));
}

uint mask[1024];

void main() {
    const uint g = gl_GlobalInvocationID.x;
    const uint chunk = g / ITEMS_PER_CHUNK;
    if (chunk >= uint(u_chunk_count)) return;
    const uint item = g - chunk * ITEMS_PER_CHUNK;
    const uint hb = chunk * 16u;
    const uint slot = headers[hb].x;

    const uint sec = item / 144u;
    const uint rem = item - sec * 144u;
    const bool pos = rem < 72u;
    const int dir = pos ? 1 : -1;
    const uint r = pos ? rem : rem - 72u;
    int axis;
    int s;
    if (r < 32u) {
        axis = 0;
        s = int(r);
    } else if (r < 40u) {
        axis = 1;
        s = int(sec) * 8 + int(r - 32u);
    } else {
        axis = 2;
        s = int(r - 40u);
    }
    // Оси среза как в CPU: X -> u=Z, v=Y; Y -> u=X, v=Z; Z -> u=X, v=Y.
    const int ua = (axis == 0) ? 2 : 0;
    const int va = (axis == 1) ? 2 : 1;
    const int v_base = (va == 1) ? int(sec) * 8 : 0;
    const int v_count = (va == 1) ? 8 : 32;
    const uint face = uint(axis) * 2u + (pos ? 0u : 1u);

    // Маска ключей среза (как в CPU): id | meta<<8 | свет<<16 | PRESENT | ROTATE.
    bool any_key = false;
    for (int v = 0; v < v_count; ++v) {
        for (int u = 0; u < 32; ++u) {
            ivec3 c;
            c[axis] = s;
            c[ua] = u;
            c[va] = v_base + v;
            uint key = 0u;
            const uint cur = block_at(hb, c.x, c.y, c.z);
            const uint fc = block_flags[cur];
            if ((fc & FLAG_GREEDY) != 0u) {
                ivec3 nc = c;
                nc[axis] += dir;
                const uint nb = block_at(hb, nc.x, nc.y, nc.z);
                const bool cull_same = (fc & FLAG_CULL_SAME) != 0u;
                if ((block_flags[nb] & FLAG_TRANSPARENT) != 0u && !(nb == cur && cull_same)) {
                    uint meta = 0u;
                    if ((fc & FLAG_USES_META) != 0u) {
                        meta = read_channel(hb, 1u, uint((c.y * 32 + c.z) * 32 + c.x));
                    }
                    const uint lut = rect_lut[(cur * 6u + face) * 256u + meta];
                    uint fl = light_at(hb, nc.x, nc.y, nc.z);
                    if (cull_same) fl = light_coarse[fl];
                    key = KEY_PRESENT | ((lut & 0x8000u) != 0u ? KEY_ROTATE : 0u) |
                          cur | (meta << 8u) | (fl << 16u);
                    any_key = true;
                }
            }
            mask[v * 32 + u] = key;
        }
    }
    if (!any_key) return;

    // Жадное слияние, порядок обхода как в CPU: по строкам v, внутри строки по u.
    for (int v = 0; v < v_count; ++v) {
        int u = 0;
        while (u < 32) {
            const uint key = mask[v * 32 + u];
            if (key == 0u) {
                ++u;
                continue;
            }
            int w = 1;
            int h = 1;
            if ((key & KEY_ROTATE) == 0u) {
                while (u + w < 32 && mask[v * 32 + u + w] == key) ++w;
                bool grow = true;
                while (v + h < v_count && grow) {
                    for (int i = 0; i < w; ++i) {
                        if (mask[(v + h) * 32 + u + i] != key) {
                            grow = false;
                            break;
                        }
                    }
                    if (grow) ++h;
                }
            }
            for (int dv = 0; dv < h; ++dv) {
                for (int du = 0; du < w; ++du) {
                    mask[(v + dv) * 32 + u + du] = 0u;
                }
            }

            ivec3 o;
            o[axis] = s;
            o[ua] = u;
            o[va] = v_base + v;
            const uint cur = key & 0xFFu;
            const uint meta = (key >> 8u) & 0xFFu;
            const uint rect = rect_lut[(cur * 6u + face) * 256u + meta] & 0x7FFFu;
            const uint light = (key >> 16u) & 0xFFu;
            const uint w0 = uint(o.x) | (uint(o.y) << 5u) | (uint(o.z) << 10u) |
                            (uint(axis) << 15u) | ((pos ? 1u : 0u) << 17u) |
                            (uint(w - 1) << 18u) | (uint(h - 1) << 23u) |
                            ((key & KEY_ROTATE) != 0u ? (1u << 28u) : 0u);
            const uint w1 = rect | (light << 16u);

            const uint gsec = slot * 4u + sec;
            const uint idx = atomicAdd(counts[gsec], 1u);
            if (idx < uint(u_quad_cap)) {
                quads[gsec * uint(u_quad_cap) + idx] = uvec2(w0, w1);
            }
            u += w;
        }
    }
}
