#version 430 core
// GPU-версия жадного мешера непрозрачной геометрии (см. Renderer::submit_gpu_batch и build_chunk_mesh в Chunk.cpp).
// Одна инвокация разбирает ОДИН срез одной секции в одном направлении грани: по 72 среза на секцию
// (32 по X, 8 по Y, 32 по Z) и два знака, то есть 576 работ на чанк. Срезы независимы: слияние
// идёт только внутри среза, как и в CPU-проходе, поэтому квады совпадают с CPU по составу.
//
// Вход — упакованные каналы чанка (палитры + биты, см. pack_channel в Chunk.cpp). Выход — 8-байтные
// записи квадов в пул (раскладка записи — в декодере terrain_gpu_vertex.glsl), по CAP записей на секцию.
//
// Ключ среза: UV-прямоугольник/поворот, AO и свет четырёх углов. Соседние блоки разных типов с одной
// текстурой сливаются, только если совпадают AO и свет всех углов (как в CPU-мешере).
layout(local_size_x = 64) in;

// Заголовок чанка: kGpuHeaderStride = 17 uvec4 (см. Chunk.h). [0].x = слот пула; [1 + ch] = (палитра,
// слова, биты, 0) канала ch.
layout(std430, binding = 0) readonly buffer Headers { uvec4 headers[]; };
layout(std430, binding = 1) readonly buffer Payload { uint payload[]; };
layout(std430, binding = 2) writeonly buffer Quads { uvec4 quads[]; };
layout(std430, binding = 3) buffer Counts { uint counts[]; };
// (id * 6 + грань) * 256 + метаданные -> индекс прямоугольника UV | поворот << 15.
layout(std430, binding = 4) readonly buffer Lut { uint rect_lut[]; };
// Таблицы правил: сначала light_coarse (256 слов), за ними block_flags — по id, длина по числу блоков.
layout(std430, binding = 5) readonly buffer Tables { uint light_coarse[256]; uint block_flags[]; };

uniform int u_chunk_count;
uniform int u_quad_cap;

const uint FLAG_GREEDY = 1u;
const uint FLAG_TRANSPARENT = 2u;
const uint FLAG_USES_META = 4u;
const uint FLAG_CULL_SAME = 8u;
const uint FLAG_OCCLUDES = 16u;
const uint ITEMS_PER_CHUNK = 576u;
// Шаг заголовка на чанк: слот + 16 каналов. Должен совпадать с kGpuHeaderStride в Chunk.h.
const uint HEADER_STRIDE = 17u;

// Значение i канала ch чанка hb. Битность 0 — одно значение палитры; иначе номер бит [i*b, i*b+b),
// возможно через границу двух слов.
uint read_channel(uint hb, uint ch, uint i) {
    const uvec4 c = headers[hb + 1u + ch];
    const uint bits = c.z;
    if (bits == 0u) return payload[c.x];
    const uint bit = i * bits;
    const uint w = c.y + (bit >> 5u);
    const uint s = bit & 31u;
    uint v = payload[w] >> s;
    if (s + bits > 32u) v |= payload[w + 1u] << (32u - s);
    return payload[c.x + (v & ((1u << bits) - 1u))];
}

// Индекс клетки кольца рёбер и углов (две или три координаты вне 0..31). Совпадает с chunk_ring_index
// в Chunk.h: рёбра вдоль Y — 0..127, вдоль X — 128..255, вдоль Z — 256..383, углы — 384..391.
int ring_index(int x, int y, int z) {
    const bool ox = x < 0 || x >= 32;
    const bool oy = y < 0 || y >= 32;
    const bool oz = z < 0 || z >= 32;
    const int px = x >= 32 ? 1 : 0;
    const int py = y >= 32 ? 1 : 0;
    const int pz = z >= 32 ? 1 : 0;
    if (int(ox) + int(oy) + int(oz) == 3) return 384 + px + 2 * py + 4 * pz;
    if (!oy) return (px + 2 * pz) * 32 + y;
    if (!ox) return 128 + (py + 2 * pz) * 32 + x;
    return 256 + (px + 2 * py) * 32 + z;
}

// Блок в клетке (x,y,z) чанка, за одной его границей (грани соседей) или в кольце рёбер и углов.
// Грани соседей: ячейка (a,b) лежит в индексе b*32+a; -X/+X: a=z,b=y; -Y/+Y: a=x,b=z; -Z/+Z: a=x,b=y.
uint block_at(uint hb, int x, int y, int z) {
    const int out_axes = int(x < 0 || x >= 32) + int(y < 0 || y >= 32) + int(z < 0 || z >= 32);
    if (out_axes >= 2) return read_channel(hb, 15u, uint(ring_index(x, y, z)));
    if (x < 0) return read_channel(hb, 3u, uint(y * 32 + z));
    if (x >= 32) return read_channel(hb, 4u, uint(y * 32 + z));
    if (y < 0) return read_channel(hb, 5u, uint(z * 32 + x));
    if (y >= 32) return read_channel(hb, 6u, uint(z * 32 + x));
    if (z < 0) return read_channel(hb, 7u, uint(y * 32 + x));
    if (z >= 32) return read_channel(hb, 8u, uint(y * 32 + x));
    return read_channel(hb, 0u, uint((y * 32 + z) * 32 + x));
}

uint light_at(uint hb, int x, int y, int z) {
    if (x < 0) return read_channel(hb, 9u, uint(y * 32 + z));
    if (x >= 32) return read_channel(hb, 10u, uint(y * 32 + z));
    if (y < 0) return read_channel(hb, 11u, uint(z * 32 + x));
    if (y >= 32) return read_channel(hb, 12u, uint(z * 32 + x));
    if (z < 0) return read_channel(hb, 13u, uint(y * 32 + x));
    if (z >= 32) return read_channel(hb, 14u, uint(y * 32 + x));
    return read_channel(hb, 2u, uint((y * 32 + z) * 32 + x));
}

// Закрывает ли клетка свет AO: полный непрозрачный куб (см. Mesh_Tables::occludes в Chunk.cpp).
bool occludes(uint hb, int x, int y, int z) {
    return (block_flags[block_at(hb, x, y, z)] & FLAG_OCCLUDES) != 0u;
}

// Вершинный AO четырёх углов грани клетки cell (ось axis, знак sign), как face_ao в Chunk.cpp: угол
// fu + 2*fv получает уровень 0..3 по двум боковым клеткам слоя перед гранью и по диагональной клетке.
uint face_ao(uint hb, ivec3 cell, int axis, int sign, int ua, int va) {
    ivec3 base = cell;
    base[axis] += sign;
    uint code = 0u;
    for (int fv = 0; fv < 2; ++fv) {
        for (int fu = 0; fu < 2; ++fu) {
            const int du = fu != 0 ? 1 : -1;
            const int dv = fv != 0 ? 1 : -1;
            ivec3 p1 = base;
            ivec3 p2 = base;
            ivec3 p3 = base;
            p1[ua] += du;
            p2[va] += dv;
            p3[ua] += du;
            p3[va] += dv;
            const bool s1 = occludes(hb, p1.x, p1.y, p1.z);
            const bool s2 = occludes(hb, p2.x, p2.y, p2.z);
            const bool s3 = occludes(hb, p3.x, p3.y, p3.z);
            const uint level = (s1 && s2) ? 0u : 3u - (uint(s1) + uint(s2) + uint(s3));
            code |= level << uint(2 * (fu + 2 * fv));
        }
    }
    return code;
}

// Ключ грани: .x = индекс UV-прямоугольника | поворот<<15; .y = AO<<8 | присутствие<<16;
// .z = свет четырёх углов (байт угла: sky<<4 | blk). Для слияния сравнивается ВЕСЬ ключ.
uvec3 mask[1024];

// Свет четырёх углов грани (как face_corner_light в Chunk.cpp): среднее по клетке перед гранью и по
// трём клеткам слоя, непрозрачные клетки не учитываются, клетки за двумя границами чанка тоже.
uint face_corner_light(uint hb, ivec3 cell, int axis, int sign, int ua, int va) {
    ivec3 base = cell;
    base[axis] += sign;
    uint code = 0u;
    for (int fv = 0; fv < 2; ++fv) {
        for (int fu = 0; fu < 2; ++fu) {
            const int du = fu != 0 ? 1 : -1;
            const int dv = fv != 0 ? 1 : -1;
            ivec3 pts[4];
            pts[0] = base;
            pts[1] = base;
            pts[2] = base;
            pts[3] = base;
            pts[1][ua] += du;
            pts[2][va] += dv;
            pts[3][ua] += du;
            pts[3][va] += dv;
            uint sky_sum = 0u;
            uint blk_sum = 0u;
            uint n = 0u;
            for (int i = 0; i < 4; ++i) {
                const ivec3 p = pts[i];
                const int out_axes = int(p.x < 0 || p.x >= 32) + int(p.y < 0 || p.y >= 32) +
                                     int(p.z < 0 || p.z >= 32);
                if (out_axes >= 2) continue;
                if (i > 0 && occludes(hb, p.x, p.y, p.z)) continue;
                const uint packed = light_at(hb, p.x, p.y, p.z);
                sky_sum += packed >> 4u;
                blk_sum += packed & 15u;
                ++n;
            }
            const uint sky = (sky_sum + n / 2u) / n;
            const uint blk = (blk_sum + n / 2u) / n;
            code |= ((sky << 4u) | blk) << uint(8 * (fu + 2 * fv));
        }
    }
    return code;
}

void main() {
    const uint g = gl_GlobalInvocationID.x;
    const uint chunk = g / ITEMS_PER_CHUNK;
    if (chunk >= uint(u_chunk_count)) return;
    const uint item = g - chunk * ITEMS_PER_CHUNK;
    const uint hb = chunk * HEADER_STRIDE;
    const uint slot = headers[hb].x;

    const uint sec = item / 144u;
    const uint rem = item - sec * 144u;
    const bool pos = rem < 72u;
    const int dir = pos ? 1 : -1;
    const uint r = pos ? rem : rem - 72u;
    int axis;
    int s;
    if (r < 32u) {
        axis = 0;
        s = int(r);
    } else if (r < 40u) {
        axis = 1;
        s = int(sec) * 8 + int(r - 32u);
    } else {
        axis = 2;
        s = int(r - 40u);
    }
    // Оси среза как в CPU: X -> u=Z, v=Y; Y -> u=X, v=Z; Z -> u=X, v=Y.
    const int ua = (axis == 0) ? 2 : 0;
    const int va = (axis == 1) ? 2 : 1;
    const int v_base = (va == 1) ? int(sec) * 8 : 0;
    const int v_count = (va == 1) ? 8 : 32;
    const uint face = uint(axis) * 2u + (pos ? 0u : 1u);

    // Маска ключей среза (как в CPU, см. mask выше). Ключ 0 — граней нет
    // (у любого жадно-мешаемого блока id не равен нулю).
    bool any_key = false;
    for (int v = 0; v < v_count; ++v) {
        for (int u = 0; u < 32; ++u) {
            ivec3 c;
            c[axis] = s;
            c[ua] = u;
            c[va] = v_base + v;
            uvec3 key = uvec3(0u);
            const uint cur = block_at(hb, c.x, c.y, c.z);
            const uint fc = block_flags[cur];
            if ((fc & FLAG_GREEDY) != 0u) {
                ivec3 nc = c;
                nc[axis] += dir;
                const uint nb = block_at(hb, nc.x, nc.y, nc.z);
                const bool cull_same = (fc & FLAG_CULL_SAME) != 0u;
                if ((block_flags[nb] & FLAG_TRANSPARENT) != 0u && !(nb == cur && cull_same)) {
                    uint meta = 0u;
                    if ((fc & FLAG_USES_META) != 0u) {
                        meta = read_channel(hb, 1u, uint((c.y * 32 + c.z) * 32 + c.x));
                    }
                    const uint material = rect_lut[(cur * 6u + face) * 256u + meta] & 0xFFFFu;
                    const uint ao = face_ao(hb, c, axis, dir, ua, va);
                    key = uvec3(material, (ao << 8u) | (1u << 16u), face_corner_light(hb, c, axis, dir, ua, va));
                    any_key = true;
                }
            }
            mask[v * 32 + u] = key;
        }
    }
    if (!any_key) return;

    // Жадное слияние, порядок обхода как в CPU: по строкам v, внутри строки по u.
    for (int v = 0; v < v_count; ++v) {
        int u = 0;
        while (u < 32) {
            const uvec3 key = mask[v * 32 + u];
            if (key == uvec3(0u)) {
                ++u;
                continue;
            }
            const uint lut = key.x;
            // Повёрнутая текстура (бревно на боку) не сливается: квад 1x1.
            const bool rotate = (lut & 0x8000u) != 0u;
            int w = 1;
            int h = 1;
            if (!rotate) {
                while (u + w < 32 && mask[v * 32 + u + w] == key) ++w;
                bool grow = true;
                while (v + h < v_count && grow) {
                    for (int i = 0; i < w; ++i) {
                        if (mask[(v + h) * 32 + u + i] != key) {
                            grow = false;
                            break;
                        }
                    }
                    if (grow) ++h;
                }
            }
            for (int dv = 0; dv < h; ++dv) {
                for (int du = 0; du < w; ++du) {
                    mask[(v + dv) * 32 + u + du] = uvec3(0u);
                }
            }

            ivec3 o;
            o[axis] = s;
            o[ua] = u;
            o[va] = v_base + v;
            const uint rect = lut & 0x7FFFu;
            const uint ao = (key.y >> 8u) & 0xFFu;
            const uint w0 = uint(o.x) | (uint(o.y) << 5u) | (uint(o.z) << 10u) |
                            (uint(axis) << 15u) | ((pos ? 1u : 0u) << 17u) |
                            (uint(w - 1) << 18u) | (uint(h - 1) << 23u) |
                            (rotate ? (1u << 28u) : 0u);
            // w1: индекс прямоугольника (15 бит), AO (8 бит). w2: свет четырёх углов.
            const uint w1 = rect | (ao << 24u);

            const uint gsec = slot * 4u + sec;
            const uint idx = atomicAdd(counts[gsec], 1u);
            if (idx < uint(u_quad_cap)) {
                quads[gsec * uint(u_quad_cap) + idx] = uvec4(w0, w1, key.z, 0u);
            }
            u += w;
        }
    }
}
