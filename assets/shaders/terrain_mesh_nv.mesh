#version 450 core
#extension GL_NV_mesh_shader : require
#extension GL_ARB_shader_draw_parameters : require

// Mesh shading replacement for terrain_gpu_vertex.glsl. The compute mesher still
// writes compact 16-byte quads; this stage expands them directly into indexed meshes.
layout(local_size_x = 32) in;
layout(triangles, max_vertices = 128, max_primitives = 64) out;

struct TaskPayload {
    uint first_quad;
    uint quad_count;
    uint chunk_handle;
    uint section;
    uint kind;
};
taskNV in TaskPayload {
    uint first_quad;
    uint quad_count;
    uint chunk_handle;
    uint section;
    uint kind;
} payload;

layout(std430, binding = 2) readonly buffer Quads { uvec4 quads[]; };
layout(std430, binding = 8) readonly buffer Rects { vec4 rects[]; };
layout(std430, binding = 9) readonly buffer Origins { vec4 origins[]; };

uniform mat4 view_projection;
uniform float time;

out vec2 Local[];
out float NormalY[];
out vec3 WorldPos[];
out vec3 WorldNormal[];
out float BlockLight[];
out float SkyLight[];
out float Appearance[];
flat out vec4 Rect[];
out float AO[];

// Corner order is identical to the old vertex-pulling shader. The triangle index
// table preserves face winding and lets the mesh shader emit 4 unique vertices per quad.
const int kCorner[36] = int[36](
    0,2,3, 0,3,1,
    0,3,2, 0,1,3,
    0,3,1, 0,2,3,
    0,1,3, 0,3,2,
    0,1,3, 0,3,2,
    0,3,1, 0,2,3);
const int kCornerFlip[36] = int[36](
    0,2,1, 1,2,3,
    0,1,2, 1,3,2,
    0,2,1, 1,2,3,
    0,1,2, 1,3,2,
    0,1,2, 1,3,2,
    0,2,1, 1,2,3);

void main() {
    const uint quad_base = gl_WorkGroupID.x * 32u;
    const uint quad_count = min(32u, payload.quad_count - min(quad_base, payload.quad_count));
    // The NV primitive count is a workgroup output; invocation zero owns it.
    if (gl_LocalInvocationIndex == 0u) gl_PrimitiveCountNV = quad_count * 2u;

    const uint lane = gl_LocalInvocationIndex;
    if (lane >= quad_count) return;

    const uint quad_index = payload.first_quad + quad_base + lane;
    const uvec4 rec = quads[quad_index];
    const uint w0 = rec.x;
    const uint w1 = rec.y;
    const uint w2 = rec.z;
    const uint axis = (w0 >> 15u) & 3u;
    const bool pos = ((w0 >> 17u) & 1u) != 0u;
    const float width = float(((w0 >> 18u) & 31u) + 1u);
    const float height = float(((w0 >> 23u) & 31u) + 1u);
    const bool rotate_uv = ((w0 >> 28u) & 1u) != 0u;
    const float normal_extent = float(1u << ((w0 >> 29u) & 3u));
    const uint ao_bits = (w1 >> 24u) & 0xFFu;
    const bool flip = ((ao_bits & 3u) + ((ao_bits >> 6u) & 3u)) >
                      (((ao_bits >> 2u) & 3u) + ((ao_bits >> 4u) & 3u));
    const uint variant = axis * 2u + (pos ? 0u : 1u);
    const uint vertex_base = lane * 4u;
    const uint primitive_base = lane * 2u;
    const vec3 cell = vec3(float(w0 & 31u), float((w0 >> 5u) & 31u), float((w0 >> 10u) & 31u));
    const vec4 chunk_origin = origins[payload.chunk_handle];
    const vec3 base = chunk_origin.xyz + cell;
    const float plane = pos ? normal_extent : 0.0;
    const vec4 rect = rects[w1 & 0x7FFFu];

    // Every invocation owns one quad and writes four independent corner vertices.
    for (uint corner = 0u; corner < 4u; ++corner) {
        const float fu = float(corner & 1u);
        const float fv = float(corner >> 1u);
        vec3 p;
        vec2 local;
        if (axis == 0u) {
            p = vec3(base.x + plane, base.y + fv * height, base.z + fu * width);
            local = vec2(fu * width, fv * height);
        } else if (axis == 1u) {
            p = vec3(base.x + fu * width, base.y + plane, base.z + fv * height);
            local = vec2(fu * width, (1.0 - fv) * height);
        } else {
            p = vec3(base.x + fu * width, base.y + fv * height, base.z + plane);
            local = vec2(fu * width, fv * height);
        }
        if (rotate_uv) local = vec2(local.y, 1.0 - local.x);

        float appear = clamp((time - chunk_origin.w) / 0.42, 0.0, 1.0);
        appear = appear * appear * (3.0 - 2.0 * appear);

        vec3 world_normal = vec3(0.0);
        if (axis == 0u) world_normal.x = pos ? 1.0 : -1.0;
        else if (axis == 1u) world_normal.y = pos ? 1.0 : -1.0;
        else world_normal.z = pos ? 1.0 : -1.0;

        const uint light_byte = (w2 >> (8u * corner)) & 0xFFu;
        const uint ao = (ao_bits >> (2u * corner)) & 3u;
        const uint out_vertex = vertex_base + corner;
        gl_MeshVerticesNV[out_vertex].gl_Position = view_projection * vec4(p, 1.0);
        Appearance[out_vertex] = appear;
        Local[out_vertex] = local;
        NormalY[out_vertex] = axis == 1u ? (pos ? 1.0 : -1.0) : 0.0;
        WorldPos[out_vertex] = p;
        WorldNormal[out_vertex] = world_normal;
        BlockLight[out_vertex] = float(light_byte & 15u);
        SkyLight[out_vertex] = float(light_byte >> 4u);
        Rect[out_vertex] = rect;
        AO[out_vertex] = float(ao);
    }

    const uint table_offset = variant * 6u;
    const int c0 = flip ? kCornerFlip[table_offset + 0u] : kCorner[table_offset + 0u];
    const int c1 = flip ? kCornerFlip[table_offset + 1u] : kCorner[table_offset + 1u];
    const int c2 = flip ? kCornerFlip[table_offset + 2u] : kCorner[table_offset + 2u];
    const int c3 = flip ? kCornerFlip[table_offset + 3u] : kCorner[table_offset + 3u];
    const int c4 = flip ? kCornerFlip[table_offset + 4u] : kCorner[table_offset + 4u];
    const int c5 = flip ? kCornerFlip[table_offset + 5u] : kCorner[table_offset + 5u];
    const uint index_base = primitive_base * 3u;
    gl_PrimitiveIndicesNV[index_base + 0u] = vertex_base + uint(c0);
    gl_PrimitiveIndicesNV[index_base + 1u] = vertex_base + uint(c1);
    gl_PrimitiveIndicesNV[index_base + 2u] = vertex_base + uint(c2);
    gl_PrimitiveIndicesNV[index_base + 3u] = vertex_base + uint(c3);
    gl_PrimitiveIndicesNV[index_base + 4u] = vertex_base + uint(c4);
    gl_PrimitiveIndicesNV[index_base + 5u] = vertex_base + uint(c5);
}
