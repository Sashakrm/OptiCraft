#version 430 core
// Финализация GPU-мешера: по числу квадов и маске видимости секций пишет команду
// glMultiDrawArraysIndirect для каждой пары (слот, секция). Индекс команды = глобальный номер секции
// (слот*4 + секция) и он же уходит в baseInstance: вершинный шейдер берёт по нему свою секцию.
layout(local_size_x = 64) in;

layout(std430, binding = 3) readonly buffer Counts { uint counts[]; };
// Битовая маска видимых секций слота: бит s — секция s попала во frustum и слот активен.
layout(std430, binding = 6) readonly buffer Vis { uint vis[]; };
// DrawArraysIndirectCommand: count, instanceCount, first, baseInstance.
layout(std430, binding = 7) writeonly buffer Cmd { uvec4 cmds[]; };

uniform int u_section_total;
uniform int u_quad_cap;

void main() {
    const uint g = gl_GlobalInvocationID.x;
    if (g >= uint(u_section_total)) return;
    const uint slot = g >> 2u;
    const uint sec = g & 3u;
    const uint quads = min(counts[g], uint(u_quad_cap));
    const bool visible = ((vis[slot] >> sec) & 1u) != 0u;
    cmds[g] = uvec4((visible && quads > 0u) ? quads * 6u : 0u, 1u, 0u, g);
}
